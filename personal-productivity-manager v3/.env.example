# Server-side configuration. Copy to .env NEXT TO docker-compose.yml on the SERVER. Never commit .env.
# None of these values belong in the Android app.

POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=generate-with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# OAuth *web* client ID from Google Cloud (public value, also used by the app build). Needed for sign-in.
GOOGLE_WEB_CLIENT_ID=

# WhatsApp Cloud API (Meta) - only needed for WhatsApp features
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_TEMPLATE_MORNING=morning_tasks
WHATSAPP_TEMPLATE_FOLLOWUP=task_followup
WHATSAPP_TEMPLATE_EVENING=daily_report
WHATSAPP_TEMPLATE_LANG=en
